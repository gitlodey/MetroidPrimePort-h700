# Approved native ARM64 integration-slice profile. Input locations are supplied
# separately, only after build.py verifies and stages the pinned archives.
set(CMAKE_C_COMPILER clang-16 CACHE FILEPATH "")
set(CMAKE_CXX_COMPILER clang++-16 CACHE FILEPATH "")
set(CMAKE_BUILD_TYPE RelWithDebInfo CACHE STRING "")
set(CMAKE_C_FLAGS "-mcpu=cortex-a53 -fsigned-char" CACHE STRING "")
set(CMAKE_CXX_FLAGS "-mcpu=cortex-a53 -fsigned-char" CACHE STRING "")
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "")
set(BUILD_SHARED_LIBS OFF CACHE BOOL "")

set(AURORA_H700 ON CACHE BOOL "")
set(AURORA_BUNDLED_DEPS ON CACHE BOOL "")
foreach(feature GX DVD CARD THP)
  set(AURORA_ENABLE_${feature} ON CACHE BOOL "")
endforeach()
set(AURORA_ENABLE_RMLUI OFF CACHE BOOL "")
set(AURORA_ENABLE_EXAMPLES OFF CACHE BOOL "")
set(AURORA_ENABLE_TESTS OFF CACHE BOOL "")
set(AURORA_CACHE_USE_ZSTD ON CACHE BOOL "")

set(AURORA_DAWN_PROVIDER package CACHE STRING "")
set(AURORA_DAWN_LINKAGE static CACHE STRING "")
set(AURORA_DAWN_VERSION v20261029.114630 CACHE STRING "")
set(AURORA_DAWN_REF 118436b3f8f68583eb86e811ca605dc41637e8cc CACHE STRING "")
set(AURORA_NOD_PROVIDER package CACHE STRING "")
set(AURORA_NOD_LINKAGE static CACHE STRING "")
set(AURORA_NOD_VERSION v2.0.0-alpha.12 CACHE STRING "")
set(AURORA_SDL3_PROVIDER vendor CACHE STRING "")
set(AURORA_SDL3_LINKAGE shared CACHE STRING "")
set(AURORA_SDL3_REF 6057d79baf8321bf190479a699655f06cc2a962f CACHE STRING "")

set(SDL_SDL2_BACKEND ON CACHE BOOL "")
set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "")
set(SDL_SHARED ON CACHE BOOL "")
set(SDL_STATIC OFF CACHE BOOL "")
foreach(feature GPU RENDER_GPU X11 WAYLAND KMSDRM TESTS TEST_LIBRARY INSTALL INSTALL_TESTS)
  set(SDL_${feature} OFF CACHE BOOL "")
endforeach()

# The fixed image has no zlib/zstd development packages. The driver verifies the
# actual source targets after configuration instead of accepting a system fallback.
set(CMAKE_DISABLE_FIND_PACKAGE_PkgConfig ON CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_xxHash ON CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_Tracy ON CACHE BOOL "")
set(ZSTD_BUILD_STATIC ON CACHE BOOL "")
set(ZSTD_BUILD_SHARED OFF CACHE BOOL "")
set(ZSTD_BUILD_PROGRAMS OFF CACHE BOOL "")
set(ZSTD_BUILD_TESTS OFF CACHE BOOL "")
set(ZSTD_BUILD_CONTRIB OFF CACHE BOOL "")
