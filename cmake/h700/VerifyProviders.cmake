# Shared post-Aurora assertions for the root game and the integration driver.
foreach(dep DAWN NOD)
  if(NOT AURORA_${dep}_PROVIDER STREQUAL "package" OR NOT AURORA_${dep}_LINKAGE STREQUAL "static")
    message(FATAL_ERROR "Unexpected ${dep} provider/linkage")
  endif()
endforeach()
if(NOT AURORA_SDL3_PROVIDER STREQUAL "vendor" OR NOT AURORA_SDL3_LINKAGE STREQUAL "shared" OR
   NOT AURORA_SDL3_REF STREQUAL "6057d79baf8321bf190479a699655f06cc2a962f")
  message(FATAL_ERROR "The pinned shared SDL2-backed SDL fork is required")
endif()

function(h700_source_target target input)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Missing source dependency: ${target}")
  endif()
  get_target_property(real "${target}" ALIASED_TARGET)
  if(NOT real)
    set(real "${target}")
  endif()
  get_target_property(imported "${real}" IMPORTED)
  get_target_property(source "${real}" SOURCE_DIR)
  set(expected "${H700_INPUTS_DIR}/${input}")
  cmake_path(IS_PREFIX expected "${source}" NORMALIZE matches)
  if(imported OR NOT matches)
    message(FATAL_ERROR "${target} must be built from staged ${input}, got ${source}")
  endif()
  set_property(GLOBAL APPEND PROPERTY H700_PROVIDER_REPORT "${target}=${real}:source:${source}\n")
endfunction()

function(h700_package_target target input)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Missing package dependency: ${target}")
  endif()
  get_target_property(real "${target}" ALIASED_TARGET)
  if(NOT real)
    set(real "${target}")
  endif()
  get_target_property(imported "${real}" IMPORTED)
  get_target_property(kind "${real}" TYPE)
  get_target_property(location "${real}" IMPORTED_LOCATION)
  if(NOT location)
    get_target_property(location "${real}" IMPORTED_LOCATION_RELEASE)
  endif()
  set(expected "${H700_INPUTS_DIR}/${input}")
  cmake_path(IS_PREFIX expected "${location}" NORMALIZE matches)
  if(NOT imported OR NOT kind STREQUAL "STATIC_LIBRARY" OR NOT matches)
    message(FATAL_ERROR "${target} must use the staged static ${input} package, got ${location}")
  endif()
  set_property(GLOBAL APPEND PROPERTY H700_PROVIDER_REPORT "${target}=${real}:package:${location}\n")
endfunction()

h700_source_target(SDL3::SDL3 sdl)
h700_source_target(ZLIB::ZLIB zlib)
h700_source_target(zstd::libzstd zstd)
h700_package_target(dawn::webgpu_dawn dawn)
h700_package_target(nod::nod_static nod)
get_target_property(nod_default nod::nod ALIASED_TARGET)
get_target_property(nod_links nod::nod INTERFACE_LINK_LIBRARIES)
if(NOT nod_default STREQUAL "nod::nod_static" AND NOT "nod::nod_static" IN_LIST nod_links)
  message(FATAL_ERROR "nod::nod must select nod::nod_static")
endif()
get_property(providers GLOBAL PROPERTY H700_PROVIDER_REPORT)
string(JOIN "" providers ${providers})
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/providers.txt" "${providers}")
