#!/bin/sh
# The installer will fill this with one safely quoted literal absolute path.
DISC=''
set -eu
[ "$#" -eq 0 ] || { printf '%s\n' 'Launch this entry from muOS Ports; no runtime options' >&2; exit 2; }
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec "$HERE/.metroid-prime-unbound-h700/run-game.sh" "$DISC"
